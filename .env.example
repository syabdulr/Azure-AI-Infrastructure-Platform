# Azure Configuration
AZURE_SUBSCRIPTION_ID=[YOUR_SUBSCRIPTION_ID]
AZURE_TENANT_ID=[YOUR_TENANT_ID]
AZURE_CLIENT_ID=[YOUR_CLIENT_ID]
AZURE_CLIENT_SECRET=[YOUR_CLIENT_SECRET]
AZURE_RESOURCE_GROUP=[YOUR_RESOURCE_GROUP]
AZURE_LOCATION=eastus

# Azure OpenAI Configuration
AZURE_OPENAI_RESOURCE=[YOUR_OPENAI_RESOURCE]
AZURE_OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
AZURE_OPENAI_ENDPOINT=[YOUR_OPENAI_ENDPOINT]
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure Cognitive Search Configuration
AZURE_SEARCH_SERVICE=[YOUR_SEARCH_SERVICE]
AZURE_SEARCH_INDEX=ai-knowledge-base

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT=[YOUR_STORAGE_ACCOUNT]
AZURE_STORAGE_CONTAINER=documents

# Azure Key Vault Configuration
AZURE_KEY_VAULT_NAME=[YOUR_KEY_VAULT_NAME]

# Azure Monitor Configuration
AZURE_APP_INSIGHTS_NAME=[YOUR_APP_INSIGHTS_NAME]

# Application Configuration
APP_NAME=azure-ai-infra-platform
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
SECRET_KEY=[YOUR_SECRET_KEY]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Content Filtering
CONTENT_FILTER_ENABLED=true
PII_DETECTION_ENABLED=true

# Monitoring
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true
TRACING_ENABLED=true

# Cost Optimization
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD_USd=100