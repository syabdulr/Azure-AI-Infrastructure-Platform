# Azure AI Infrastructure Platform - Environment Configuration
# Copy this file to .env and configure your values

# ==========================================
# AZURE CONFIGURATION
# ==========================================

# Azure OpenAI Configuration
# Get these from: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub/~/OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002

# Azure Cognitive Search Configuration
# Get these from: https://portal.azure.com/#view/Hubs_CognitiveServices/SearchResource
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=azure-ai-docs
AZURE_SEARCH_INDEXER_NAME=azure-ai-indexer

# Azure Storage Configuration
# Get these from: https://portal.azure.com/#blade/Microsoft_Azure_Storage/ContainerMenuBlade/overview/storageAccountId/%2Fsubscriptions%2FsubscriptionId%2FresourceGroups%2FresourceGroup%2Fproviders%2FMicrosoft.Storage%2FstorageAccounts%2FstorageAccountName
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=documents

# Azure Key Vault (Optional)
# Get these from: https://portal.azure.com/#view/Microsoft_Azure_KeyVault/KeysVaultMenuBlade/~/overview
AZURE_KEY_VAULT_NAME=your-keyvault
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# App Metadata
APP_NAME=Azure AI Infrastructure Platform
APP_VERSION=1.0.0
APP_ENVIRONMENT=development  # Options: development, staging, production
LOG_LEVEL=INFO              # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ==========================================
# MONITORING & OBSERVABILITY
# ==========================================

MONITORING_ENABLED=true
PROMETHEUS_ENABLED=true
ALERT_MANAGER_ENABLED=true
TELEMETRY_ENABLED=false

# Application Insights (Optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ==========================================
# FEATURE FLAGS
# ==========================================

ENABLE_CHAT=true
ENABLE_RAG=true
ENABLE_GUARDRAILS=true
ENABLE_PROMPT_MANAGEMENT=true
ENABLE_OBSERVABILITY=true

# ==========================================
# CORS CONFIGURATION
# ==========================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# ==========================================
# SECURITY
# ==========================================

# JWT Secret (for future authentication)
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==========================================
# DEMO MODE CONFIGURATION
# ==========================================

# Demo mode allows running the application without Azure credentials
# Set to true to use mock responses for demonstration
DEMO_MODE=false

# ==========================================
# NOTES
# ==========================================

# For local development without Azure credentials:
# 1. Set DEMO_MODE=true
# 2. The application will return mock responses
# 3. Swagger UI and metrics will still work
# 4. This is perfect for recruiter demos

# For production deployment:
# 1. Set DEMO_MODE=false
# 2. Configure all Azure credentials above
# 3. Set APP_ENVIRONMENT=production
# 4. Enable all security features
# 5. Configure proper CORS origins