# Azure AI Infrastructure Platform - Environment Configuration
# Copy this file to .env and configure your values
#
# Every key below matches a field on Settings in src/config/settings.py.
# Settings uses pydantic-settings with extra="forbid" (the default), so an
# unrecognized key here will crash the app at startup with a ValidationError.
# If you add a new setting, add the field to Settings first, then add it here.

# ==========================================
# AZURE CONFIGURATION
# ==========================================

# Azure OpenAI Configuration
# Get these from: https://portal.azure.com/#view/Microsoft_Azure_ProjectOxford/CognitiveServicesHub/~/OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_CLIENT_ID=your-client-id

# Azure Cognitive Search Configuration
# Get these from: https://portal.azure.com/#view/Hubs_CognitiveServices/SearchResource
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=ai-knowledge-base

# Azure Storage Configuration
# Get these from: https://portal.azure.com/#blade/Microsoft_Azure_Storage/ContainerMenuBlade/overview/storageAccountId/%2Fsubscriptions%2FsubscriptionId%2FresourceGroups%2FresourceGroup%2Fproviders%2FMicrosoft.Storage%2FstorageAccounts%2FstorageAccountName
AZURE_STORAGE_ACCOUNT=yourstorage
AZURE_STORAGE_CONTAINER=documents
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=your-key;EndpointSuffix=core.windows.net

# Azure Key Vault / Identity (Optional)
# Get these from: https://portal.azure.com/#view/Microsoft_Azure_KeyVault/KeysVaultMenuBlade/~/overview
AZURE_KEY_VAULT_NAME=your-keyvault
AZURE_TENANT_ID=your-tenant-id

# Azure Monitor / Application Insights (Optional)
AZURE_APP_INSIGHTS_NAME=your-app-insights
AZURE_APP_INSIGHTS_INSTRUMENTATION_KEY=
AZURE_APP_INSIGHTS_CONNECTION_STRING=

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

APP_NAME=Azure AI Infrastructure Platform
APP_VERSION=1.0.0
APP_ENVIRONMENT=dev            # Must be one of: dev, staging, prod
LOG_LEVEL=INFO                 # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false                   # Set true for uvicorn --reload during local dev

# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ==========================================
# COST TRACKING
# ==========================================

COST_TRACKING_ENABLED=true
GPT4_INPUT_COST_PER_1K=0.03
GPT4_OUTPUT_COST_PER_1K=0.06
EMBEDDING_COST_PER_1K=0.0001

# ==========================================
# CHAT / RAG DEFAULTS
# ==========================================

CHAT_MAX_TOKENS_DEFAULT=1000
CHAT_TEMPERATURE_DEFAULT=0.7
CHAT_MAX_TOKENS_LIMIT=4096

RAG_TOP_K_DEFAULT=5
RAG_MIN_SCORE_DEFAULT=0.5
RAG_TOP_K_LIMIT=10

# ==========================================
# MONITORING
# ==========================================

MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=30
METRICS_RETENTION_HOURS=24

# ==========================================
# CORS CONFIGURATION
# ==========================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ==========================================
# NOTES
# ==========================================

# For local development / recruiter demos without live Azure resources:
# 1. Just leave the Azure fields above unset (they're all Optional).
# 2. `uvicorn src.main:app --reload` will start fine; /health will
#    correctly report azure_openai/cognitive_search/key_vault as
#    unhealthy/degraded rather than crashing, and /docs still works.
# 3. The `/utilities/*` routes (bill_processor, regulation_search,
#    support_automation, usage_analytics) run in simulated/demo mode
#    by default in code (see src/api/utilities_routes.py) regardless
#    of this file -- there is no DEMO_MODE setting on Settings that
#    toggles it, so don't set a DEMO_MODE key here (it will be
#    rejected as an unrecognized field).
#
# For production deployment:
# 1. Configure all Azure credentials above.
# 2. Set APP_ENVIRONMENT=prod.
# 3. Configure real CORS_ORIGINS (not "*").
